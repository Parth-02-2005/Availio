generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// USER
model User {
  id         String   @id @default(uuid())
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String   @unique
  password   String
  avatarUrl  String?  @map("avatar_url")
  isActive   Boolean  @default(true) @map("is_active")
  timezone   String?

  // Relations
  eventTypes        EventType[]
  hostedEvents      EventRegistration[] @relation("HostEvents")
  guestRegistrations EventRegistration[] @relation("GuestEvents")
  eventSlots        EventSlot[]

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// EVENT TYPE
model EventType {
  id          String   @id @default(uuid())
  hostId      String   @map("host_id")
  title       String
  description String?
  duration    Int      // minutes
  isActive    Boolean  @default(true) @map("is_active")
  location    String?

  host User @relation(fields: [hostId], references: [id])

  registrations EventRegistration[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hostId])
  @@map("event_types")
}


// EVENT SLOT (Availability)
model EventSlot {
  id         String @id @default(uuid())
  hostId     String @map("host_id")

  dayOfWeek  Int    @map("day_of_week") // 0 = Sunday
  startTime  String @map("start_time")  // Consider using DateTime if needed
  breakStart String? @map("break_start")
  breakEnd   String? @map("break_end")
  endTime    String @map("end_time")

  host User @relation(fields: [hostId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([hostId])
  @@map("event_slots")
}

// EVENT REGISTRATION (Booking)
model EventRegistration {
  id          String   @id @default(uuid())

  eventTypeId String   @map("event_type_id")
  hostId      String   @map("host_id")
  guestId     String?  @map("guest_id")

  guestName   String   @map("guest_name")
  guestEmail  String   @map("guest_email")

  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")

  status      RegistrationStatus @default(PENDING)

  eventType EventType @relation(fields: [eventTypeId], references: [id])
  host      User      @relation("HostEvents", fields: [hostId], references: [id])
  guest     User?     @relation("GuestEvents", fields: [guestId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([hostId])
  @@index([eventTypeId])
  @@index([startTime])

  @@map("event_registrations")
}
